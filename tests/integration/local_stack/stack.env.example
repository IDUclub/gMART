SERVICE_AUTH_SERVER_URL=https://keycloak.example.org
SERVICE_AUTH_REALM=IDU
SERVICE_AUTH_CLIENT_ID=gmart
SERVICE_AUTH_CLIENT_SECRET=replace-locally
AUTH_VALID_AUDIENCES=urban-api,account

# Absolute paths to the checkouts being tested (use / on Windows).
EFFECTS_CONTEXT=C:/path/to/ObjectEffectsAPI
NORMGRAPH_CONTEXT=C:/path/to/NormGraph
DVD_CONTEXT=C:/path/to/IDU_DVD
CHATSTORAGE_CONTEXT=C:/path/to/ChatStorage

# All generative clients share the remote graphify local-gpu endpoint.
LLM_BASE_URL=http://10.32.11.27:8001/v1
LLM_MODEL=gpt-oss-20b
# Required: a separate OpenAI-compatible embedding service origin, without /v1.
# local-gpu:8001 currently serves chat only and returns 404 for /v1/embeddings.
EMBEDDINGS_ORIGIN=http://a.dgx:8010
# Verified from the embedding response (the server has no /v1/models route).
EMBEDDINGS_MODEL=ai-sage/Giga-Embeddings-instruct
VECTOR_SIZE=2048
URBAN_API_ORIGIN=http://10.32.11.90:31001
URBAN_MCP_ORIGIN=http://10.32.11.90:31054
