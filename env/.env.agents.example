OLLAMA_API_URL="http:/host.docker.internal:11434"
IDU_MCP_SERVER="http://host.docker.internal:8000/mcp"
OBJECTS_EFFECTS_MCP_SERVER="http://host.docker.internal:8080/mcp"
DVD_MCP_SERVER="http://host.docker.internal:8000/mcp"
NORM_GRAPH_MCP_SERVER="http://host.docker.internal:8020/mcp"
CHAT_STORAGE="http://host.docker.internal:8010"
URBAN_API_URL="https://urban-api/api"
REDIS_URL="redis://:example_password@pipeline_storage:6379"
SYSTEM_PASSWORD="change_me"
# Optional: enables the /auth/token login proxy (UI login form). The API key is
# server-side only and never exposed to the browser.
AUTH_HELPER_URL=""
AUTH_HELPER_API_KEY=""

# LLM backend: "openai" (default) for any OpenAI-compatible server — vLLM, Ollama's
# own /v1, and friends — or "ollama" for the native Ollama client. With "openai" the
# agents talk to OPENAI_BASE_URL, and OLLAMA_API_URL is the fallback; the key is
# optional for local servers that ignore it.
# A bare origin gets "/v1" appended; a URL with a path is used as written.
# NOTE: num_ctx has no OpenAI equivalent, so on this backend the context length is
# whatever the server was started with — set OLLAMA_CONTEXT_LENGTH (Ollama defaults
# to 4096) or --max-model-len (vLLM) to match what the pipelines need.
LLM_BACKEND=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
# How the agents' think=False reaches the server (LLM_BACKEND=openai only). The
# default needs no configuration: reasoning_effort="none" is honoured by both vLLM
# and Ollama's /v1. Alternatives: "chat_template" (sends chat_template_kwargs, which
# vLLM honours and Ollama ignores) and "off" (send nothing — for a strict endpoint
# that rejects both). Leaving the trace on costs the num_predict budget on a
# reasoning model and can return empty content with finish_reason=length.
OPENAI_THINK_MODE=reasoning_effort
# Chat-template variable carrying think= when OPENAI_THINK_MODE=chat_template.
OPENAI_THINK_CHAT_TEMPLATE_KWARG=enable_thinking
