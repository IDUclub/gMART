OLLAMA_API_URL="http://host.docker.internal:11434"
IDU_MCP_SERVER="http://host.docker.internal:8000/mcp"
OBJECTS_EFFECTS_MCP_SERVER="http://host.docker.internal:8080/mcp"
DVD_MCP_SERVER="http://host.docker.internal:8000/mcp"
# Document-QA window (input + generation), default 100000. Always capped by the
# server's max_model_len; without it (Ollama, other servers) at most 32000.
# DVD_CONTEXT_WINDOW_TOKENS=100000
# Dynamic budget per generation call (reasoning + visible answer), capped by model window.
DVD_ANSWER_MIN_TOKENS=4096
DVD_ANSWER_MAX_TOKENS=16384
# Additional attempts after length/max_tokens; visible text is continued, then audited.
DVD_ANSWER_RETRIES=2
# Separate output budget for JSON summaries, including model reasoning.
DVD_SUMMARY_MAX_TOKENS=4096
DVD_REVIEW_MAX_TOKENS=4096
DVD_CONTEXT_CONCURRENCY=4
DVD_RETRIEVAL_MAX_PAGES=100
# Upper bound for the document-QA draft temperature (request temperature is capped).
DVD_ANSWER_TEMPERATURE=0.2
# Show complete sentences of the unverified draft as replaceable status snapshots.
DVD_ANSWER_PREVIEW=true
# Minimum interval between previews in ms (minimum 0); final snapshot bypasses it.
DVD_ANSWER_PREVIEW_MIN_INTERVAL_MS=700
# gpt-oss critic reasoning: medium (default, stricter) or low (~3.5x faster, weaker).
DVD_CRITIC_REASONING_EFFORT=medium
DVD_CRITIC_LOW_RISK_EFFORT=low
# Sentence IDs replace decoded quotes; code restores literal source sentences and
# checks quantities/opposite polarity. false restores the previous quote schema.
DVD_CRITIC_SENTENCE_IDS=true
# Non-gpt-oss: light audits check lines only; full audits also check omissions.
# gpt-oss keeps its existing effort-based behaviour. false always uses full audits.
DVD_ADAPTIVE_CRITIC=true
# Defaults for non-gpt-oss full audits (comma-separated; any = every risk reason):
# DVD_CRITIC_FULL_AUDIT_REASONS=previous_rejection,partial_context,document_list,no_citations,long_answer,unclassified
# With this variable unset, gpt-oss keeps absence_claim as its effort default.
# An explicit value also configures gpt-oss effort, as before.
# Explicit full/cited wins in every tier. With auto (also unset/empty), light
# uses full for absence claims and auto otherwise; full audits keep auto.
DVD_CRITIC_CONTEXT=auto
# Audit consecutive groups concurrently; each call still sees the full answer/context.
DVD_PARALLEL_CRITIC=true
# Точный адрес документа: план без LLM; при пустом результате — планировщик.
DVD_PLANNER_FAST_PATH=true
# Простой самостоятельный вопрос: семантический поиск по исходному вопросу без LLM.
DVD_PLANNER_SIMPLE_PATH=true
# Иначе на первой попытке поиск по вопросу идёт параллельно с планировщиком.
# Результат используется только при совпадении итогового запроса и фильтров.
DVD_PLANNER_PREFETCH=true
DVD_CRITIC_LINES_PER_CALL=3
DVD_CRITIC_MAX_PARALLEL=6
# Drafts over one retrieval (answer + rewrites); 3 gives gpt-oss one more try, slower.
DVD_MAX_DRAFTS_PER_RETRIEVAL=2
# Optional REST origin for user-document uploads. When omitted, gMART removes
# the trailing /mcp from DVD_MCP_SERVER.
DVD_API_URL="http://host.docker.internal:8000"
# Optional PZZ agent. REST is separate from MCP (uploads / classify-only summary).
PZZ_MCP_SERVER="http://10.32.11.90:31053/mcp"
PZZ_API_URL="http://10.32.11.90:31009"
NORM_GRAPH_MCP_SERVER="http://host.docker.internal:8020/mcp"
URBAN_MCP_SERVER="https://urban-mcp.testing.idulab.ru"
CHAT_STORAGE="http://host.docker.internal:8010"
# Explicit API roots (e.g. https://host/urban_api) are preserved; bare origins use /api.
URBAN_API_URL="https://urban-api/api"
REDIS_URL="redis://:example_password@pipeline_storage:6379"
# Log successful Redis commands at INFO; errors are always logged.
REDIS_LOG_COMMANDS=true
SYSTEM_PASSWORD="change_me"
# Optional: enables the /auth/token login proxy (UI login form). The API key is
# server-side only and never exposed to the browser.
AUTH_HELPER_URL=""
AUTH_HELPER_API_KEY=""
# Include usernames in login result logs (passwords and tokens are never logged).
AUTH_LOG_USERNAME=false
# File links (/files/..., /documents/figures/...) are relative to the agents root.
COMPLIANCE_MAX_UPLOAD_MB=50
COMPLIANCE_MAX_ARCHIVE_MEMBERS=2000
COMPLIANCE_MAX_UNPACKED_MB=200
COMPLIANCE_MAX_LAYERS=500

# Scenario-data plan-first pilot. Keep disabled until the local acceptance suite passes.
SCENARIO_DATA_LINEAR_WORKFLOW_ENABLED=false
SCENARIO_DATA_WORKSPACE_ENABLED=false

# LLM backend: "openai" (default) for any OpenAI-compatible server — vLLM, Ollama's
# own /v1, and friends — or "ollama" for the native Ollama client. With "openai" the
# agents talk to OPENAI_BASE_URL, and OLLAMA_API_URL is the fallback; the key is
# optional for local servers that ignore it.
# A bare origin gets "/v1" appended; a URL with a path is used as written.
# NOTE: num_ctx has no OpenAI equivalent, so on this backend the context length is
# whatever the server was started with — set OLLAMA_CONTEXT_LENGTH (Ollama defaults
# to 4096) or --max-model-len (vLLM) to match what the pipelines need.
LLM_BACKEND=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Fallback for calls without a request_kind (integer; lower runs earlier).
# Empty or 0 = server default. Keyed calls use the table/overrides below.
# Servers without priority support are retried without it; Ollama ignores this.
OPENAI_REQUEST_PRIORITY=
# Live per-key overrides: key=value,key=value (last valid duplicate wins).
# Defaults:
# dvd.planner=-100, dvd.conversation=-100, dvd.context_reducer=-100,
# dvd.answer=-100, dvd.critic=-100, dvd.revision=-100,
# norms.planner=-100, norms.answer=-100, norms.review=-100,
# restriction.plan=-60, restriction.explain=-60, restriction.answer=-60,
# pzz.inputs=-60, pzz.columns=-60, pzz.answer=-100,
# provision.plan=-60, provision.answer=-100,
# scenario.plan=-60, scenario.mapping=-60, scenario.answer=-100,
# scenario.judge=-100, orchestrator.plan=-100, simple_llm=-100,
# chat_title=-60, context_summary=20,
# compliance.scope=-60, compliance.mapping=-60, project.inputs=-60.
LLM_REQUEST_PRIORITIES=
# false removes priority everywhere, including the fallback and explicit values.
LLM_REQUEST_PRIORITY_ENABLED=true
# How the agents' think=False reaches the server (LLM_BACKEND=openai only). The
# default sends reasoning_effort (value from OPENAI_THINK_EFFORT below). Note this is
# not universally accepted: vLLM's Harmony path, which is how gpt-oss is served, 400s on
# reasoning_effort="none" and "minimal" alike (see OPENAI_THINK_EFFORT). Alternatives: "chat_template" (sends
# chat_template_kwargs, which vLLM honours and Ollama ignores) and "off" (send nothing —
# for a strict endpoint that rejects both). Leaving the trace on costs the num_predict budget on a
# reasoning model and can return empty content with finish_reason=length.
OPENAI_THINK_MODE=reasoning_effort
# Chat-template variable carrying think= when OPENAI_THINK_MODE=chat_template.
OPENAI_THINK_CHAT_TEMPLATE_KWARG=enable_thinking
# gpt-oss/Harmony supports low, medium and high. Low is the default for the
# short structured planning calls; it reduces reasoning but does not disable it.
# For other model servers choose an effort they support. The adapter normalizes
# none/minimal to low for gpt-oss calls carrying think=False.
OPENAI_THINK_EFFORT=low
# Pipeline deadlines (scenario-data, document-QA) are set for the LLM's usual speed and
# stretch while the shared server answers slower. Usual decode speed in tokens/s
# (gpt-oss-20b on the shared vLLM: ~130), and the most a deadline may stretch.
LLM_NOMINAL_TOKENS_PER_SECOND=100
LLM_DEADLINE_MAX_FACTOR=4

# --- Default model -----------------------------------------------------------
# Normally leave both unset: a request that names no model gets one read from the provider's
# own list (/v1/models, or /api/tags on Ollama), so the id is always right for the backend in
# use. This is what keeps an Ollama-style "gpt-oss:20b" from being sent to a vLLM that serves
# "gpt-oss-20b" — a 404 on every agent.
# DEFAULT_LLM_MODEL pins an exact id and wins over the list (useful for a hidden/aliased id).
# DEFAULT_LLM_MODEL_HINT picks which served model is preferred; "gpt-oss" matches gpt-oss-20b,
# gpt-oss:20b and openai/gpt-oss-20b alike. Without a match the first served model is used.
DEFAULT_LLM_MODEL=
DEFAULT_LLM_MODEL_HINT=gpt-oss
SERVICE_AUTH_SERVER_URL=https://keycloak.example.com
SERVICE_AUTH_REALM=IDU
SERVICE_AUTH_CLIENT_ID=gmart
SERVICE_AUTH_CLIENT_SECRET=change-me
